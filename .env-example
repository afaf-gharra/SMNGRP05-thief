# Copy to `.env` and fill in. `.env` is git-ignored and must NEVER be committed.
# Nothing in this file is required for a default match: the shipped hint provider
# is `template`, which uses zero tokens and no network.

# --- Optional: Anthropic API, only when [trash_talk] provider = "claude_api" ---
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# --- Optional: Ollama, only when [trash_talk] provider = "ollama" ---
OLLAMA_URL=http://localhost:11434/api/generate

# --- Gmail API (send-only scope). These are PATHS, not secrets themselves;
#     the files they point at are secrets and are git-ignored. See docs/PRD_gmail_reporting.md
P2P_GMAIL_CREDENTIALS=credentials.json
P2P_GMAIL_TOKEN=token.json
